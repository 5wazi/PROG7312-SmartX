@model SensorsIndexViewModel
@{
    ViewData["Title"] = "Sensor Ingestion";
}

<h1>Sensor Data Ingestion &amp; Telemetry</h1>
<p class="subtitle">Register a sensor node, attach its config/log files, and it joins the mock telemetry seeding loop automatically.</p>

<div class="card">
    <h2>Register a sensor</h2>
    <form asp-controller="Sensors" asp-action="Register" method="post">
        <div class="form-grid">
            <div>
                <label asp-for="Form.MacAddress"></label>
                <input asp-for="Form.MacAddress" placeholder="24:6F:28:AA:0B:14" />
                <span asp-validation-for="Form.MacAddress" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Form.DeploymentLocation"></label>
                <input asp-for="Form.DeploymentLocation" placeholder="Root/Facility A/Zone 1/Sub-Zone B" />
                <span asp-validation-for="Form.DeploymentLocation" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Form.Category"></label>
                <select asp-for="Form.Category" asp-items="Html.GetEnumSelectList<SensorCategory>()"></select>
            </div>
            <div>
                <label asp-for="Form.ValueKind">Value type</label>
                <select asp-for="Form.ValueKind" asp-items="Html.GetEnumSelectList<TelemetryValueKind>()"></select>
            </div>
            <div>
                <label asp-for="Form.Unit"></label>
                <input asp-for="Form.Unit" placeholder="%, W, ..." />
            </div>
            <div>
                <label asp-for="Form.SafeMin"></label>
                <input asp-for="Form.SafeMin" type="number" step="0.1" />
            </div>
            <div>
                <label asp-for="Form.SafeMax"></label>
                <input asp-for="Form.SafeMax" type="number" step="0.1" />
            </div>
        </div>
        <button class="btn gold" type="submit" style="margin-top:14px;">Register sensor</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.RegisterError))
    {
        <div class="alert error">@Model.RegisterError</div>
    }
    @if (Model.RegisterSuccess)
    {
        <div class="alert success">Sensor registered and added to the seeding loop.</div>
    }
</div>

<div class="card" style="margin-top:20px;">
    <h2>Registered sensors (<span id="sensorCount">@Model.Sensors.Count</span>)</h2>
    <table id="sensorTable">
        <thead>
        <tr>
            <th>Status</th>
            <th>MAC</th>
            <th>Location</th>
            <th>Category</th>
            <th>Latest</th>
            <th>Streak</th>
            <th>Attachment</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Sensors)
        {
            <tr data-sensor-id="@s.Id">
                <td class="status-cell"><span class="badge @(s.IsOnline ? "online" : "offline")">@(s.IsOnline ? "Online" : "Offline")</span></td>
                <td>@s.MacAddress</td>
                <td>@s.DeploymentLocation</td>
                <td>@s.Category</td>
                <td class="latest-cell">@(s.RecentValues.Count > 0 ? $"{s.RecentValues[^1]:0.##}{s.Unit}" : "—")</td>
                <td class="streak-cell">🔥 @s.CurrentStreak <span style="color:var(--muted); font-weight:400;">(best @s.BestStreak)</span></td>
                <td>
                    @if (s.AttachmentFileName is not null)
                    {
                        <a href="@s.AttachmentUrl" target="_blank">@s.AttachmentFileName</a>
                    }
                    else
                    {
                        <form asp-controller="Sensors" asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="sensorId" value="@s.Id" />
                            <input type="file" name="file" required />
                            <button class="btn" type="submit">Upload</button>
                        </form>
                    }
                </td>
                <td>
                    <form asp-controller="Sensors" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@s.Id" />
                        <button class="btn" style="background:#8a2d2d;" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Poll /Sensors/List every few seconds and refresh just the status/latest/streak
        // cells, so the table stays live without disrupting an in-progress form fill.
        SmartX.pollSensorTable();
    </script>
}
